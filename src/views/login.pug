extends layout

block content
  .row.justify-content-center
    .col-md-6
      .card.shadow-sm.mt-5
        .card-header.bg-primary.text-white
          h4.mb-0 Iniciar Sesión
        .card-body
          if error
            .alert.alert-danger= error
          form(action="/auth/login", method="POST")
            .mb-3
              label.form-label(for="username") Usuario
              input#username.form-control(type="text", name="username", required, autofocus)
            .mb-3
              label.form-label(for="password") Contraseña
              input#password.form-control(type="password", name="password", required)
            .d-grid
              button.btn.btn-primary(type="submit") Ingresar
